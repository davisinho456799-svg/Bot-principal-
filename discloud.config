NAME=BotPrincipal
TYPE=bot
MAIN=main.js
RAM=3072
VERSION=22
BUILD=corepack enable && corepack prepare pnpm@10.26.1 --activate && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm install --frozen-lockfile && if [ -n "$NEW_DATABASE_URL" ]; then echo 'Applying database schema from NEW_DATABASE_URL'; DATABASE_URL="$NEW_DATABASE_URL" pnpm --filter @workspace/db run push; else echo 'NEW_DATABASE_URL not set; skipping database schema push'; fi && pnpm --filter @workspace/api-server run build
START=node --enable-source-maps main.js
AUTORESTART=true
APT=puppeteer