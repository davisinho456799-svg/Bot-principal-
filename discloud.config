NAME=BotPrincipal
TYPE=bot
MAIN=main.js
RAM=4096
VERSION=22
BUILD=corepack enable && corepack prepare pnpm@10.26.1 --activate && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm install --frozen-lockfile && pnpm --filter @workspace/api-server run build
START=node --enable-source-maps main.js
AUTORESTART=true
APT=chromium